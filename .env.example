# Clerk Authentication
# https://dashboard.clerk.com/ -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_d2l0dHktamFndWFyLTEyLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_XWRizxEnaqqbc2hWrB6DR1kABkI0l8877MrLOQc4mf
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Supabase (Database & Storage)
# Local: values from `supabase start` (Publishable / Secret / Database URL)
# Hosted: https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only — never expose to the browser (replaces legacy service_role)
SUPABASE_SECRET_KEY=sb_secret_...
POSTGRES_URL=your-database-url

# Email
POSTMARK_SERVER_TOKEN=0cbb9724-ea6b-4e57-8828-43f212d6ac87
FROM_EMAIL=notifications@telosready.com

# Telos Brain (Execution API)
# Per-brain key printed once on first `brain deploy --instance <name>`
BRAIN_URL=https://your-brain-execution-host
BRAIN_API_KEY=your-per-brain-execution-api-key

# Tool webhooks (Brain → this app) — dual-secret handshake
# 1) Authorization: Bearer <TOOL_API_KEY>
# 2) X-Brain-Authorization: Bearer <BRAIN_API_KEY> (same value as above)
# Brain schema tools must inject both via secret: TOOL_API_KEY and secret: BRAIN_API_KEY
TOOL_API_KEY=your-shared-tool-api-key
